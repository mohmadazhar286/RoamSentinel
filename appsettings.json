{
  "RoamSentinel": {
    "BindUrl": "http://127.0.0.1:5117"
  },
  "Database": {
    "FilePath": "roamsentinel.db",
    "CommandTimeoutSeconds": 30,
    "BusyTimeoutMilliseconds": 5000,
    "ImportLegacyJson": true,
    "PersistTelemetrySnapshots": true,
    "TelemetryPersistenceIntervalSeconds": 300,
    "TelemetryRetentionDays": 7
  },
  "Telemetry": {
    "CollectionIntervalSeconds": 8,
    "ConnectionCommandTimeoutSeconds": 12,
    "DefenderCommandTimeoutSeconds": 10,
    "InventoryCommandTimeoutSeconds": 20,
    "DeviceIntegrityCommandTimeoutSeconds": 60,
    "DeviceIntegrityIntervalSeconds": 300,
    "DeviceIntegrityFileLimit": 500,
    "MonitoredFileDirectories": [],
    "SuspiciousPathMarkers": ["\\appdata\\local\\temp\\", "\\appdata\\roaming\\", "\\downloads\\", "\\users\\public\\"]
  },
  "Detection": {
    "FindingPersistenceIntervalSeconds": 60,
    "CriticalSeverityScore": 90,
    "HighSeverityScore": 70,
    "MediumSeverityScore": 45,
    "LowSeverityScore": 20,
    "ConnectionAlertMinimumScore": 55,
    "ProcessAlertMinimumScore": 50,
    "StartupAlertMinimumScore": 40,
    "MaxAlertsPerCategory": 30,
    "StaleQuickScanDays": 7,
    "ManyConnectionsThreshold": 25,
    "PublicConnectionScore": 20,
    "SensitivePortScore": 35,
    "ScriptableProcessScore": 35,
    "UserWritablePathScore": 25,
    "AgentUnauthorizedScore": 80,
    "StartupUserWritableScore": 40,
    "StartupScriptScore": 35,
    "SensitivePorts": [23, 2323, 4444, 5555, 6667, 1337, 31337, 3389, 5900],
    "ScriptableProcesses": ["powershell", "pwsh", "wscript", "cscript", "mshta", "rundll32", "regsvr32", "cmd"],
    "UserWritablePathMarkers": ["\\appdata\\local\\temp\\", "\\appdata\\roaming\\", "\\downloads\\", "\\users\\public\\"]
  },
  "Response": {
    "DryRun": false,
    "CommandTimeoutSeconds": 25,
    "ScanLaunchTimeoutSeconds": 8,
    "FileScanTimeoutSeconds": 120,
    "OperatorToken": "",
    "FirewallRulePrefix": "RoamSentinel",
    "LegacyFirewallRulePrefix": "RoamSentinel Legacy"
  },
  "AgentGovernance": {
    "IdentityMarkers": ["codex", "chatgpt", "claude", "anthropic", "cursor", "windsurf", "aider", "openhands", "roo-code", "roo-cline", "cline", "github.copilot", "copilot-language-server"],
    "UserWritablePathMarkers": ["\\users\\", "\\appdata\\", "\\temp\\", "\\downloads\\"],
    "ObservationPersistenceIntervalSeconds": 60,
    "UnusualRemoteAddressThreshold": 8,
    "TrustedPathRiskScore": 10,
    "UnknownPathRiskScore": 55,
    "UserWritablePathRiskScore": 70,
    "UnusualNetworkRiskScore": 80,
    "BlockedRunningRiskScore": 100
  },
  "AccessControl": {
    "ViewerToken": "",
    "AnalystToken": "",
    "AdministratorToken": "",
    "SessionMinutes": 30,
    "SessionCookieName": "RoamSentinel.Session",
    "CsrfHeaderName": "X-RoamSentinel-CSRF"
  },
  "StructuredLogging": {
    "Directory": ".",
    "RetentionDays": 7
  },
  "ThreatIntel": {
    "RequestTimeoutSeconds": 15,
    "CacheMinutes": 360,
    "VirusTotalMaliciousThreshold": 3,
    "AbuseIpDbMaxAgeDays": 90,
    "VirusTotal": {
      "Enabled": false,
      "ApiKey": "",
      "BaseUrl": "https://www.virustotal.com"
    },
    "AbuseIpDb": {
      "Enabled": false,
      "ApiKey": "",
      "BaseUrl": "https://api.abuseipdb.com"
    },
    "AlienVaultOtx": {
      "Enabled": false,
      "ApiKey": "",
      "BaseUrl": "https://otx.alienvault.com"
    },
    "Misp": {
      "Enabled": false,
      "ApiKey": "",
      "BaseUrl": "",
      "VerifyTls": true
    }
  },
  "Dashboard": {
    "RefreshIntervalMilliseconds": 8000,
    "HeavyMemoryThresholdMb": 500,
    "HeavyCpuThresholdPercent": 10,
    "TopProcessLimit": 20,
    "EventReviewLimit": 500,
    "MemoryWarningPercent": 70,
    "MemoryDangerPercent": 85
  },
  "Scheduler": {
    "Enabled": true,
    "LoopIntervalSeconds": 30,
    "TelemetrySnapshotIntervalSeconds": 300,
    "AppActivityIntervalSeconds": 900,
    "MalwarePostureIntervalSeconds": 1800,
    "QuickScanIntervalHours": 24,
    "FullScanIntervalDays": 7,
    "EnableScheduledQuickScan": false,
    "EnableScheduledFullScan": false,
    "RetentionCheckIntervalHours": 24,
    "WeeklyReviewIntervalDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
